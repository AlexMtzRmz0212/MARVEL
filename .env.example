# Read by the API from the repo root (and backend/.env, which wins).
#
# TMDB_API_KEY powers the catalog editor's poster picker (/admin) and the
# scripts in backend/scripts. OMDB_API_KEY is for those scripts only.
TMDB_API_KEY=YOUR_TMDB_KEY
OMDB_API_KEY=YOUR_OMDB_KEY

# The password that unlocks the catalog editor at /admin -- as an argon2 hash,
# never the password itself. Generate it with:
#   cd backend && .venv\Scripts\python.exe scripts\hash_admin_password.py
# Keep the single quotes: the hash contains "$".
#
# Unset in dev: the editor is open (catalog.bat needs no password).
# Unset anywhere else: the editor does not exist (404) -- it fails closed.
ADMIN_PASSWORD_HASH=

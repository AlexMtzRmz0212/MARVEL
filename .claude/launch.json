{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "prod",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "catalog",
      "runtimeExecutable": "backend/.venv/Scripts/streamlit.exe",
      "runtimeArgs": ["run", "backend/scripts/catalog_editor.py", "--server.port", "8502", "--server.headless", "true"],
      "port": 8502
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173"],
      "cwd": "frontend",
      "port": 5173
    }
  ]
}

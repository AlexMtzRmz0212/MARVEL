# WARNING: Vite inlines every VITE_* variable into the client bundle at build
# time. Never put a secret in one -- these are public by construction.
#
# .env.development and .env.production are committed and cover both normal
# setups. Copy this to .env.local only to point the SPA at a different API.

VITE_API_BASE_URL=/api

# Set only when serving from a subpath instead of a domain root.
# VITE_BASE_PATH=/MARVEL/

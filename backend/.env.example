ENVIRONMENT=dev

# Local Postgres, or a Neon connection string.
# On Vercel this MUST be Neon's *pooled* host (the one containing "-pooler"),
# because serverless functions cannot hold their own connection pool.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mcu

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Comma-separated. Only needed in dev, where Vite serves the SPA on :5173.
CORS_ORIGINS=http://localhost:5173

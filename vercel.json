{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "server.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/|.*\\.).*)", "destination": "/index.html" }
  ]
}
